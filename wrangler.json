{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spentrack",
  "main": "worker.ts",
  "compatibility_date": "2025-02-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_NAME": "SpenTrack"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spentrack-db",
      "database_id": "c8cfb3bb-54da-4519-9286-35e7cb753abf"
    }
  ]
}
